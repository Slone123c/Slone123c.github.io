---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPosts } from '../../lib/posts';
import { sitePath } from '../../lib/path';
const posts = await getPosts();
---
<Base title="文章">
  <p class="eyebrow">Writing</p>
  <h1>文章</h1>
  <div class="card-grid">{posts.map(p => <ArticleCard {...p} />)}</div>
  <div class="sec-head sec-gap"><h2>Trace 范例</h2></div>
  <div class="card-grid">
    <a class="tr-card tr-card--link" href={sitePath('trace/preview/ArticlePage.html')}><div class="tr-card__top"><span class="tr-card__kicker">Data Structure</span></div><h3 class="tr-card__title">Go map：一次查找到底经过了什么</h3><p class="tr-card__summary">文章版式范例：从 hash 到 bucket 到 tophash。</p><div class="tr-card__foot"><span class="tr-tag">范例</span></div></a>
    <a class="tr-card tr-card--link" href={sitePath('trace/preview/SystemPage.html')}><div class="tr-card__top"><span class="tr-card__kicker">Systems</span></div><h3 class="tr-card__title">一切都经过 apiserver</h3><p class="tr-card__summary">系统剖析版式范例：Kubernetes 控制面的组件拓扑。</p><div class="tr-card__foot"><span class="tr-tag">范例</span></div></a>
    <a class="tr-card tr-card--link" href={sitePath('trace/preview/HomePage.html')}><div class="tr-card__top"><span class="tr-card__kicker">Home</span></div><h3 class="tr-card__title">主页范例</h3><p class="tr-card__summary">Hero、单步演示与文章网格的版式演示。</p><div class="tr-card__foot"><span class="tr-tag">范例</span></div></a>
  </div>
</Base>
